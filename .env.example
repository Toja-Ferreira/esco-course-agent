# Copy to .env and fill in. Never commit .env.

# Model
DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-chat       # pin the model before reported runs
# LLM_CALL_TIMEOUT_S=60      # whole call, for replies that come in one piece (judge, queries, drafts)
# LLM_STREAM_GAP_S=30        # gap between chunks of the streamed conversation reply
#                            # a timed-out call is retried once; then the turn ends with a message

# Data (parquet files + skill embeddings)
ESCO_DATA_DIR=data

# Hugging Face: EmbeddingGemma is a gated model; a read token is enough
HF_TOKEN=

# Docker on the VM only: POF's Docker network, which this app joins (see deploy/DEPLOY.md)
# POF_NETWORK=<pof-docker-network>
# Docker on the VM only: the user that owns results/ and hf-cache/ (output of `id -u` / `id -g`)
# APP_UID=1000
# APP_GID=1000

# Web page
HOST=127.0.0.1
PORT=8090                            # behind nginx at /esco/; keep it off POF's ports
ESCO_DAILY_LIMIT=400                 # model turns per day, all users together
# ESCO_SALT=                         # for the email hash; default: results/.salt (keep that file)

# Login. Pick ONE:
#
# (a) Through POF (used for the teacher test): the page is served on POF's address
#     under /esco/ (nginx), so it reuses the POF login the browser already has.
ESCO_AUTH=pof
POF_API_URL=http://<pof-backend-host>:<port>   # POF's backend as seen from this app
ESCO_ALLOWED_ROLES=esco_test,administrator  # POF roles let in
#
# (b) The university login directly (needs this app's own WSO2 client). Leave
#     ESCO_AUTH unset and fill these in.
#
# (c) Neither: the page asks for an email (development only).
#
# University of Aveiro login (OpenID Connect via wso2-gw.ua.pt).
# Needs this app's OWN client registration with the university, with the
# redirect URI below allowed. Leave empty to type an email instead (development).
UA_OAUTH_CLIENT_ID=
UA_OAUTH_CLIENT_SECRET=
UA_OAUTH_REDIRECT_URI=               # e.g. https://<vm-address>/auth/callback
ESCO_SESSION_SECRET=                 # long random string, e.g. python -c "import secrets; print(secrets.token_hex(32))"
ESCO_ALLOWED_DOMAINS=ua.pt           # only these email domains get in
# UA_OAUTH_PKCE=0                    # only if the gateway rejects PKCE

# Optional extra password in front of everything (HTTP basic auth)
# ESCO_WEB_USER=
# ESCO_WEB_PASSWORD=
